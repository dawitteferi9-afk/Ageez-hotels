# Ageez Hotels — Environment Variables (EXAMPLE ONLY)
# Copy to .env.local for local development. Never commit real secrets.

# --- Database ---
# Local dev: any reachable Postgres instance. Later: Supabase (or equivalent) for hosted.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ageez_hotels?schema=public"

# --- Auth.js (M4 Phase 2: Credentials provider + bcrypt + JWT sessions) ---
# Required — signs/encrypts the JWT session cookie for staff login at
# /management/login. Generate a real value locally with `npx auth secret`
# (or `openssl rand -base64 33`) and put it in .env.local ONLY. This
# placeholder must never be used outside local dev, and no real secret
# belongs in this file or in git.
AUTH_SECRET="replace-with-generated-secret"
AUTH_URL="http://localhost:3000"

# --- AI Provider (M6a: src/lib/ai/provider.ts) ---
# AI_PROVIDER selects the concrete AiProvider implementation. Defaults to
# "mock" (deterministic, no network, no key needed) whenever this is unset
# or anything other than "anthropic" — local dev/test/CI never accidentally
# calls a live model. Set to "anthropic" to use the real Claude Messages
# API adapter (src/lib/ai/providers/anthropic.ts).
AI_PROVIDER="mock"

# Required only when AI_PROVIDER=anthropic. Read server-side only, via the
# Anthropic SDK's own default env-var resolution — never referenced in a
# "use client" file, a prop, a prompt, or a log line. Never expose this key
# to client-side code.
ANTHROPIC_API_KEY="replace-with-real-key-in-local-env-only"

# --- Concierge verified-context tokens (M6c: src/lib/ai/verifiedContext.ts) ---
# Signs/verifies the short-lived (30 min) token issued after a guest
# verifies their booking on the public /concierge chat, so the anonymous
# concierge can answer questions about that ONE guest's own reservation
# for the rest of that browser session. Server-only — never read in a
# "use client" file, never returned in a response body, never logged, and
# never forwarded to the AI provider/prompt. Generate a real value locally
# with `openssl rand -base64 33` (or `npx auth secret`) and put it in
# .env.local ONLY, or your deployment's own secret manager. This
# placeholder must never be used outside local dev, and no real secret
# belongs in this file or in git.
CONCIERGE_TOKEN_SECRET="replace-with-generated-secret"

# --- App ---
# NODE_ENV is deliberately NOT set here. Next.js manages it itself for each
# command (dev/build/start) — hardcoding it in an env file that gets
# blanket-sourced (e.g. `export $(grep -v '^#' .env.local | xargs)`, the
# documented workaround for the Prisma CLI not auto-loading .env.local)
# forces a non-"production" value into `next build`'s own process
# environment and is a confirmed trigger for a spurious `<Html> should not
# be imported outside of pages/_document` crash while prerendering the
# framework's own built-in /500 page (M10 root-cause finding — see
# docs/CHANGELOG.md). Do not add NODE_ENV back to this file or to
# .env.local.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Default/dev tenant (used by seed script only; not read by runtime logic) ---
DEV_SEED_TENANT_SLUG="ageez-grand-hotel"

# --- Search-indexing control (review-deployment preparation) ---
# Leave unset for local dev and any real production deployment — the app
# is fully indexable by default, no configuration needed. Set to "review"
# ONLY on a temporary review/staging deployment to add noindex/nofollow
# (both a robots.txt disallow and a page meta tag — see src/app/robots.ts
# and src/app/layout.tsx). Not tied to any specific hosting provider.
DEPLOYMENT_STAGE="review"
