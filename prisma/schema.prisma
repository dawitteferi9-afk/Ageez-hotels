// Ageez Hotels — Prisma schema
//
// M1: full multi-tenant data model. Every tenant-owned model carries a
// `hotelId` field referencing Hotel, indexed, and is only ever queried
// through the centralized tenant-aware data-access layer in
// src/lib/tenant/ — no ad hoc `where: { hotelId }` filtering scattered
// through route handlers or components (see docs/SECURITY.md).
//
// Hotel business data (Ageez Grand Hotel's own rooms/prices/policies) is
// NOT in this file — it is seeded as DB rows by prisma/seed/index.ts from
// fixtures under src/config/defaults/seed/. This file defines shape only.
//
// See docs/DATABASE.md for the design rationale and docs/DECISIONS.md for
// the specific naming/scope decisions made when this schema was finalized.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Tenant root
// ─────────────────────────────────────────────────────────────────────────

/// The tenant root. In v0.1 exactly one row exists (Ageez Grand Hotel), but
/// nothing in the schema assumes a single tenant.
model Hotel {
  id   String @id @default(cuid())
  name String
  slug String @unique

  city    String
  country String

  contactEmail String?
  contactPhone String?

  checkInTime  String // e.g. "14:00" — display string, not a DB-enforced time
  checkOutTime String // e.g. "11:00"
  currency     String // ISO-ish code as used in UI, e.g. "ETB"

  /// Which v0.1 modules are turned on for this hotel (Dashboard, Reservations,
  /// Rooms, Guests, Housekeeping, Maintenance, Services, Reports, ...).
  /// Dev/platform default lives in src/config/defaults; per-hotel override is
  /// this column.
  enabledModules String[]

  /// Multilingual Support Phase 1 — which of the platform's supported guest
  /// locales (`src/i18n/routing.ts`'s `LOCALES`: en/am/zh/es/ar) this hotel
  /// has turned on, following the exact same per-tenant-toggle shape as
  /// `enabledModules` above. `en` (the platform default) is always assumed
  /// available even if a row predates this column / omits it, but is listed
  /// explicitly for every hotel going forward rather than relied on
  /// implicitly. Locale *content* (translated room/policy text) is a
  /// separate, later concern (Phase 3) — this column only controls whether
  /// a locale's URL space is reachable for this hotel at all.
  enabledLocales String[] @default(["en"])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roomTypes          RoomType[]
  rooms              Room[]
  guests             Guest[]
  reservations       Reservation[]
  serviceRequests    ServiceRequest[]
  maintenanceIssues  MaintenanceIssue[]
  staffUsers         StaffUser[]
  aiKnowledgeDocs    AiKnowledgeDocument[]
}

// ─────────────────────────────────────────────────────────────────────────
// Inventory
// ─────────────────────────────────────────────────────────────────────────

model RoomType {
  id     String @id @default(cuid())
  hotel  Hotel  @relation(fields: [hotelId], references: [id])
  hotelId String

  name        String
  description String
  capacity    Int
  basePrice   Decimal @db.Decimal(10, 2)
  currency    String

  rooms Room[]

  /// Multilingual Support Phase 3 — approved translations of `name`/
  /// `description` only. This row (English) is always the canonical
  /// source of truth; see `RoomTypeTranslation`'s own comment.
  translations RoomTypeTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hotelId, name])
  @@index([hotelId])
}

/// Multilingual Support Phase 3 — an approved translation of one
/// `RoomType`'s guest-facing textual fields into one non-English locale.
/// Deliberately narrow: only `name`/`description` (the two fields Phase 2's
/// audit classified as translatable prose) — `capacity`/`basePrice`/
/// `currency` stay on `RoomType` itself, language-neutral operational data
/// never duplicated here (docs/MULTILINGUAL.md's content boundary).
///
/// `locale` is a plain string (not a Prisma enum) so the platform's locale
/// list can grow without a schema migration — validated at the application
/// layer against `src/i18n/routing.ts`'s `LOCALES`, matching how
/// `Hotel.enabledLocales` (a `String[]`) already works. Never `"en"`: the
/// parent `RoomType` row IS the English content, so an English translation
/// row would just be a redundant duplicate of it, not a new fact.
///
/// `name`/`description` are nullable independently so fallback can work at
/// FIELD granularity (docs/MULTILINGUAL.md's fallback contract) — e.g. a
/// locale with an approved translated `name` but no `description` yet
/// falls back to the canonical English description for that one field
/// only, never rendering a blank field or falling back to English for
/// both just because one is missing.
///
/// Always resolved through `withTenant(hotelId).roomTypes.findManyLocalized()`/
/// `findUniqueLocalized()`/`localize()` (`src/lib/tenant/index.ts`) — never
/// queried directly by `roomTypeId` alone from a route/component, so
/// tenant isolation is enforced by construction: a translation is only
/// ever reachable through a `RoomType` row this hotel's own tenant-scoped
/// query already resolved.
model RoomTypeTranslation {
  id         String   @id @default(cuid())
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  roomTypeId String

  locale String

  name        String?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomTypeId, locale])
  @@index([roomTypeId])
}

enum RoomStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  CLEANING
  MAINTENANCE
  OUT_OF_SERVICE
}

model Room {
  id     String @id @default(cuid())
  hotel  Hotel  @relation(fields: [hotelId], references: [id])
  hotelId String

  roomType   RoomType @relation(fields: [roomTypeId], references: [id])
  roomTypeId String

  roomNumber String
  floor      Int
  status     RoomStatus @default(AVAILABLE)

  reservations      Reservation[]
  maintenanceIssues MaintenanceIssue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hotelId, roomNumber])
  @@index([hotelId])
  @@index([hotelId, status])
}

// ─────────────────────────────────────────────────────────────────────────
// Guests + reservations (no rows seeded in M1 — created live in the M3 demo)
// ─────────────────────────────────────────────────────────────────────────

model Guest {
  id     String @id @default(cuid())
  hotel  Hotel  @relation(fields: [hotelId], references: [id])
  hotelId String

  name        String
  email       String?
  phone       String?
  nationality String?

  reservations    Reservation[]
  serviceRequests ServiceRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hotelId])
}

enum ReservationStatus {
  CREATED
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum PaymentMethod {
  PAY_AT_HOTEL
}

model Reservation {
  id     String @id @default(cuid())
  hotel  Hotel  @relation(fields: [hotelId], references: [id])
  hotelId String

  guest   Guest  @relation(fields: [guestId], references: [id])
  guestId String

  room   Room   @relation(fields: [roomId], references: [id])
  roomId String

  checkIn    DateTime
  checkOut   DateTime
  guestCount Int

  status          ReservationStatus @default(CREATED)
  totalPrice      Decimal           @db.Decimal(10, 2)
  paymentMethod   PaymentMethod     @default(PAY_AT_HOTEL)
  specialRequests String?

  serviceRequests ServiceRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hotelId])
  @@index([hotelId, status])
  @@index([roomId, checkIn, checkOut])
}

// ─────────────────────────────────────────────────────────────────────────
// Service + maintenance operations (no rows seeded in M1)
// ─────────────────────────────────────────────────────────────────────────

enum ServiceRequestType {
  AIRPORT_TRANSFER
  LAUNDRY
  ROOM_SERVICE
  RESTAURANT
  OTHER
}

enum ServiceRequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ServiceRequest {
  id     String @id @default(cuid())
  hotel  Hotel  @relation(fields: [hotelId], references: [id])
  hotelId String

  reservation   Reservation? @relation(fields: [reservationId], references: [id])
  reservationId String?

  guest   Guest?  @relation(fields: [guestId], references: [id])
  guestId String?

  type   ServiceRequestType
  status ServiceRequestStatus @default(PENDING)
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hotelId])
  @@index([hotelId, status])
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model MaintenanceIssue {
  id     String @id @default(cuid())
  hotel  Hotel  @relation(fields: [hotelId], references: [id])
  hotelId String

  room   Room   @relation(fields: [roomId], references: [id])
  roomId String

  description String
  priority    MaintenancePriority @default(MEDIUM)
  status      MaintenanceStatus  @default(OPEN)

  assignedTo   StaffUser? @relation(fields: [assignedToId], references: [id])
  assignedToId String?

  resolutionNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hotelId])
  @@index([hotelId, status])
}

// ─────────────────────────────────────────────────────────────────────────
// Staff (auth wiring — M4 Phase 1: additive passwordHash column for
// Auth.js Credentials + bcrypt, per docs/DECISIONS.md 2026-08-25 entry.
// Session/adapter tables are not needed — Auth.js uses JWT sessions.)
// ─────────────────────────────────────────────────────────────────────────

enum StaffRole {
  OWNER_ADMIN
  MANAGER
  FRONT_DESK
  HOUSEKEEPING
  MAINTENANCE
}

model StaffUser {
  id     String @id @default(cuid())
  hotel  Hotel  @relation(fields: [hotelId], references: [id])
  hotelId String

  name         String
  email        String @unique
  role         StaffRole
  passwordHash String // bcrypt hash; never the plaintext password

  assignedMaintenanceIssues MaintenanceIssue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hotelId])
}

// ─────────────────────────────────────────────────────────────────────────
// AI knowledge (grounds the M6 concierge / M7 management assistant per
// docs/AI_SPEC.md — never source for fabricated facts, always DB data)
// ─────────────────────────────────────────────────────────────────────────

model AiKnowledgeDocument {
  id     String @id @default(cuid())
  hotel  Hotel  @relation(fields: [hotelId], references: [id])
  hotelId String

  category String // e.g. "policies", "amenities", "services", "dining"
  content  String
  version  Int    @default(1)

  /// Multilingual Support Phase 3 — approved translations of `content`.
  /// See `AiKnowledgeDocumentTranslation`'s own comment.
  translations AiKnowledgeDocumentTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hotelId, category])
  @@index([hotelId])
}

/// Multilingual Support Phase 3 — an approved translation of one
/// `AiKnowledgeDocument`'s `content` into one non-English locale. Same
/// design as `RoomTypeTranslation` (see its comment for the full
/// rationale — plain-string `locale`, never `"en"`, nullable for
/// field-level fallback, tenant isolation enforced by only ever being
/// resolved through a tenant-scoped parent lookup).
///
/// A single free-text `content` field mirrors the parent model exactly —
/// there is no structured per-venue/per-fact breakdown to translate
/// separately (see `docs/MULTILINGUAL.md`'s note on
/// `src/lib/guest/knowledgeHighlights.ts`'s highlight/venue chip LABELS,
/// which are presentation-layer vocabulary translated via the existing
/// `messages/<locale>.json` catalogs, not this table — this table only
/// ever holds a translation of the full source paragraph itself).
///
/// This is deliberately ONE knowledge base with approved localized
/// representations of the SAME facts, not five independently-authored
/// per-language knowledge bases: a translation is only ever produced BY
/// translating this row's own parent `content`, never authored
/// independently, so it can never assert a fact the English source
/// doesn't already state.
model AiKnowledgeDocumentTranslation {
  id         String              @id @default(cuid())
  document   AiKnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String

  locale String

  content String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([documentId, locale])
  @@index([documentId])
}
